{
  "name": "proctor-demo-agent",
  "version": "0.1.0",
  "description": "A deliberately degrading demo agent: answers PROCTOR exams with a strong model, then a weak one, so re-tests catch the swap",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && tsc -p test/tsconfig.json",
    "deploy:strong": "wrangler deploy --var MODE:strong",
    "deploy:weak": "wrangler deploy --var MODE:weak",
    "deploy:stall-test": "wrangler deploy --name proctor-stall-agent --var MODE:strong --var STALL_MS:40000"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261101.1",
    "@types/node": "24.19.2",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "wrangler": "4.156.0"
  }
}
