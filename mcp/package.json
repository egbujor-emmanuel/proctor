{
  "name": "proctor-mcp",
  "version": "0.1.0",
  "description": "MCP server for PROCTOR: check whether an AI agent holds a live certificate before you hire it",
  "license": "MIT",
  "private": true,
  "type": "module",
  "bin": {
    "proctor-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify": "node dist/verify-cli.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@phala/dcap-qvl": "0.7.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
